# VIPE POS API
# Copy to apps/api/.env for local development. Never commit .env.

# Port the HTTP server and the socket.io gateway listen on.
PORT=4000

# Postgres connection string for the application role (never a superuser,
# never BYPASSRLS). The schema is managed by packages/db.
DATABASE_URL=postgres://vipe_api:vipe_api@localhost:5432/vipe_pos

# Origin allowed to call the API with credentials (the Next.js web app).
WEB_ORIGIN=http://localhost:3000

# HS256 key for the access JWT (at least 32 characters). Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-chars

# Mark the auth cookies Secure. Keep true behind HTTPS; false only for local
# development over plain http.
COOKIE_SECURE=false

# Lifetime of the access cookie/JWT and of the refresh session, in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
