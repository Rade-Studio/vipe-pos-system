# VIPE POS API
# Copy to apps/api/.env for local development. Never commit .env.

# Port the HTTP server and the socket.io gateway listen on.
PORT=4000

# Postgres connection string for the application role (never a superuser,
# never BYPASSRLS). The schema is managed by packages/db.
DATABASE_URL=postgres://vipe_api:vipe_api@localhost:5432/vipe_pos

# Origin allowed to call the API with credentials (the Next.js web app).
WEB_ORIGIN=http://localhost:3000

# HS256 key for the access JWT (at least 32 characters). Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-chars

# Mark the auth cookies Secure. Keep true behind HTTPS; false only for local
# development over plain http.
COOKIE_SECURE=false

# Reverse proxies in front of the API whose X-Forwarded-For entry is trusted for
# the client address (per-client pairing limits). 0 (default) ignores the header;
# the compose files set 1 (Traefik or Caddy). Never more than the real hops.
TRUST_PROXY_HOPS=0

# Lifetime of the access cookie/JWT and of the refresh session, in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Pepper of the staff PINs (at least 32 characters), independent of JWT_SECRET.
# Optional: without it PINs use a pepper derived from JWT_SECRET (pepper v1,
# a startup warning is logged, rotating JWT_SECRET invalidates every PIN).
# Once set, new PINs use it (v2) and each v1 PIN is re-hashed on its next
# correct entry. Generate it like JWT_SECRET; never change it afterwards.
# PIN_PEPPER=

# S3-compatible object storage for dish images (presigned uploads). Optional:
# with none of these set the API boots and /api/storage/* answers 503
# "Storage is not configured"; setting some but not all of the required ones
# (bucket, keys, public URL) fails at startup. Development uses the `minio`
# service of docker-compose.yml (bucket vipe-dev, public read); production
# points them at Cloudflare R2 or any S3-compatible store.
# Endpoint of the S3 API; leave empty for AWS S3 itself.
S3_ENDPOINT=http://localhost:9000
# Region name; R2 uses "auto", MinIO accepts any (default us-east-1).
S3_REGION=us-east-1
S3_BUCKET=vipe-dev
S3_ACCESS_KEY_ID=vipe-minio
S3_SECRET_ACCESS_KEY=vipe-minio-secret
# Public read URL of the bucket; object URLs are <S3_PUBLIC_BASE_URL>/<key>
# and DELETE /api/storage/objects only accepts URLs under it.
S3_PUBLIC_BASE_URL=http://localhost:9000/vipe-dev
# true for <endpoint>/<bucket>/<key> addressing (MinIO); false for
# virtual-hosted buckets. Default false.
S3_FORCE_PATH_STYLE=true

# Public base URL of the signed VIPE desktop builds (F5a). The updater
# endpoint GET /api/desktop/updates/<target>/<version> answers
# <DESKTOP_RELEASES_BASE_URL>/<desktop_releases.file> for a newer release of
# the restaurant's channel (stable or pilot). Optional: unset, it always
# answers 204 (no update offered) and the heartbeat never sets updateRequired.
# Rows of desktop_releases are written by the publishing script, never by the
# API; Windows builds are stored with target `windows` (the Tauri 2
# {{target}}, the OS; {{arch}} is separate). `windows-x86_64` is read as
# `windows`.
# DESKTOP_RELEASES_BASE_URL=https://downloads.example.com/vipe-desktop
