  "info": {
    "title": "VIPE POS API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "vipe_access"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@restaurant.test"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "SessionProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "example": "admin"
          },
          "restaurantId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "restaurantId"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "profile": {
            "$ref": "#/components/schemas/SessionProfile"
          }
        },
        "required": [
          "user",
          "profile"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {}
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "active",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "maxLength": 50
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "icon"
        ]
      },
      "UpdateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "maxLength": 50
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Dish": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "description": "Price after the best active promotion when pricing=promotions applied one."
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "Opaque image reference."
          },
          "active": {
            "type": "boolean"
          },
          "allowComments": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "originalPrice": {
            "type": "number",
            "description": "Only when a promotion applies (pricing=promotions)."
          },
          "discountAmount": {
            "type": "number",
            "description": "Only when a promotion applies."
          },
          "discountPercentage": {
            "type": "number",
            "nullable": true,
            "description": "Only when a promotion applies; null for fixed amounts."
          },
          "promotionId": {
            "type": "string",
            "format": "uuid",
            "description": "Only when a promotion applies."
          },
          "promotionName": {
            "type": "string",
            "description": "Only when a promotion applies."
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "price",
          "categoryId",
          "imageUrl",
          "active",
          "allowComments",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateDishRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "allowComments": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name",
          "price"
        ]
      },
      "UpdateDishRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "allowComments": {
            "type": "boolean"
          }
        }
      },
      "Promotion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
