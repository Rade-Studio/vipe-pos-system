# ============================================
# VIPE POS - Variables de producción (docker-compose.prod.yml)
# ============================================
# Copiar este archivo a .env y completar cada valor:
#   cp env.production.template .env
# Nunca subir el .env al repositorio.
#
# Coolify (docker-compose.coolify.yml) NO usa todas estas variables. En la
# sección Environment del recurso Docker Compose cargar:
#   obligatorias: DATABASE_HOST (UUID del recurso PostgreSQL de Coolify, que
#                 es el nombre de su contenedor en la red coolify),
#                 VIPE_MIGRATOR_PASSWORD, VIPE_API_PASSWORD,
#                 JWT_SECRET, WEB_ORIGIN (https://<sitio>; en Coolify no tiene
#                 valor por defecto)
#                 y el grupo S3_* completo: en Coolify sale del MinIO
#                 compartido de la VPS; copiar el bloque que imprime
#                 deploy/shared-storage/provision-app.sh (docs/despliegue.md 4.3)
#   opcionales:   DATABASE_PORT (por defecto 5432), POSTGRES_DB, COOKIE_SECURE,
#                 ACCESS_TOKEN_TTL_SECONDS, REFRESH_TOKEN_TTL_SECONDS
#   sin uso:      POSTGRES_USER, POSTGRES_PASSWORD (la base es un recurso
#                 aparte; sus roles se crean con deploy/postgres/create-roles.sh),
#                 SITE_DOMAIN, HTTP_PORT, HTTPS_PORT, STORAGE_SITE,
#                 STORAGE_DOMAIN, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD (son de
#                 caddy y minio, que no existen en ese archivo)
#
# Las variables sin valor por defecto en docker-compose.prod.yml son
# obligatorias: el stack no arranca si faltan.
# Generar secretos aleatorios con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --------------------------------------------
# caddy (proxy inverso y HTTPS)
# --------------------------------------------
# Dominio público del POS, sin https:// (por ejemplo pos.mirestaurante.com).
# Caddy obtiene el certificado automáticamente; el DNS del dominio debe apuntar
# al VPS y los puertos 80 y 443 deben estar abiertos. Con "localhost" Caddy usa
# su CA interna (ensayo local, curl -k).
SITE_DOMAIN=pos.example.com
# Puertos publicados en el host (opcional; por defecto 80 y 443).
# HTTP_PORT=80
# HTTPS_PORT=443

# --------------------------------------------
# postgres
# --------------------------------------------
# Superusuario: solo para administración y para el script de inicio que crea
# los roles. La API nunca lo usa.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Nombre de la base de datos (opcional; por defecto vipe_pos).
POSTGRES_DB=vipe_pos
# Contraseña de vipe_migrator: dueño del esquema; lo usa el servicio migrate.
VIPE_MIGRATOR_PASSWORD=
# Contraseña de vipe_api: rol de la API, sin BYPASSRLS (RLS siempre aplica).
VIPE_API_PASSWORD=
# Los roles se crean solo la primera vez (volumen vacío). Para cambiar una
# contraseña después, ejecutar de nuevo packages/db/scripts/roles.sql como
# superusuario con psql.

# --------------------------------------------
# migrate (una sola ejecución en cada despliegue)
# --------------------------------------------
# No tiene variables propias: usa POSTGRES_DB y VIPE_MIGRATOR_PASSWORD.

# --------------------------------------------
# api (NestJS)
# --------------------------------------------
# DATABASE_URL y PORT los arma docker-compose.prod.yml (vipe_api @ postgres:5432).
# Origen permitido para CORS y socket.io. En docker-compose.prod.yml es
# opcional (por defecto https://SITE_DOMAIN; definirlo solo si el puerto
# público no es 443). En Coolify es obligatorio.
# WEB_ORIGIN=https://pos.example.com
# Clave HS256 del JWT de acceso, mínimo 32 caracteres. Cambiarla invalida los
# tokens de acceso vigentes (15 min); las sesiones siguen vivas con su refresco.
# Para cerrar todas las sesiones ver docs/despliegue.md, sección 2.7.
JWT_SECRET=
# Cookies de sesión con Secure. Mantener true en producción (HTTPS).
COOKIE_SECURE=true
# Proxies delante de la API cuya IP reenviada se confía (límites por cliente).
# 1 = Traefik (Coolify) o Caddy. Con Cloudflare delante, 1 da la IP de Cloudflare;
# usar 2 solo si el proxy (trusted_proxies en Caddy, forwardedHeaders.trustedIPs en
# Traefik) confía en los rangos de Cloudflare. Nunca más que los saltos reales.
TRUST_PROXY_HOPS=1
# Duración del token de acceso y de la sesión de refresco, en segundos.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Almacenamiento de imágenes de platos (compatible con S3). Por defecto
# Cloudflare R2. Completar el grupo entero o dejarlo entero vacío: vacío, la
# API arranca y /api/storage/* responde 503; con S3_BUCKET, las claves y
# S3_PUBLIC_BASE_URL incompletos (configuración parcial) la API no arranca.
#
# CORS del bucket (obligatorio para subir desde el navegador): en R2 permitir
# el origen https://SITE_DOMAIN con los métodos PUT (cabecera Content-Type),
# GET y HEAD. Ejemplo de política R2:
#   [{"AllowedOrigins":["https://pos.example.com"],
#     "AllowedMethods":["PUT","GET","HEAD"],
#     "AllowedHeaders":["Content-Type"],"MaxAgeSeconds":3600}]
#
# R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, región "auto",
# token de API de R2 con permiso de lectura y escritura sobre el bucket.
# Ejemplo R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# S3_REGION=auto, S3_BUCKET=vipe-pos, S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública de lectura del bucket (dominio propio o r2.dev), sin "/" final.
# Las imágenes quedan en <S3_PUBLIC_BASE_URL>/<clave>.
S3_PUBLIC_BASE_URL=
# true para direcciones <endpoint>/<bucket>/<clave> (MinIO); R2 acepta ambas.
S3_FORCE_PATH_STYLE=

# --------------------------------------------
# web (Next.js)
# --------------------------------------------
# No tiene variables: el navegador llama a su propio origen y Caddy envía
# /api y /socket.io/ a la API.

# --------------------------------------------
# Estaciones de impresión (pos/app.py, fuera de este stack)
# --------------------------------------------
# Cada estación usa VIPE_API_URL=https://SITE_DOMAIN y su VIPE_PRINTER_TOKEN
# (se crea en Administración > Configuración > Impresoras). Se conecta a /socket.io/ por
# WebSocket y llama /api/print/* con la cabecera Authorization; el firewall
# solo necesita permitir HTTPS (443) hacia el VPS.

# --------------------------------------------
# minio + minio-init (opcional, perfil self-hosted-storage)
# --------------------------------------------
# Solo si las imágenes se guardan en el mismo VPS en lugar de R2:
#   docker compose -f docker-compose.prod.yml --profile self-hosted-storage up -d
# Con STORAGE_SITE=on Caddy publica MinIO en STORAGE_DOMAIN (obligatorio en
# ese caso; el DNS también debe apuntar al VPS). Sin el perfil dejar
# STORAGE_SITE=off y STORAGE_DOMAIN vacío.
# minio-init crea el bucket S3_BUCKET: cualquiera puede leer un objeto, nadie
# puede listar el bucket. El CORS para WEB_ORIGIN lo configura el servicio
# minio. En ese caso usar:
#   S3_ENDPOINT=https://<STORAGE_DOMAIN>
#   S3_REGION=us-east-1
#   S3_ACCESS_KEY_ID=<MINIO_ROOT_USER>
#   S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
#   S3_PUBLIC_BASE_URL=https://<STORAGE_DOMAIN>/<S3_BUCKET>
#   S3_FORCE_PATH_STYLE=true
# STORAGE_SITE=on
# STORAGE_DOMAIN=storage.example.com
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
