# ============================================
# VIPE POS - Variables de Producción
# ============================================
# Copiar este archivo a .env:
# cp env.production.template .env
#
# REQUERIDO: URL y KEY de Supabase Cloud/Self-hosted
# Los valores deben apuntar a tu instancia de Supabase
# en producción (NO localhost)

# URL de tu proyecto Supabase en producción
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key pública de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opcional) Service Role Key - SOLO para uso server-side
# NUNCA expongas esta clave en el cliente
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
