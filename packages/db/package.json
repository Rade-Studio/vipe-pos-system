{
  "name": "@vipe/db",
  "version": "0.1.0",
  "private": true,
  "description": "VIPE POS database schema, migrations and Drizzle client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc src/index.ts src/migrate.ts --outDir dist --rootDir src --declaration --module commonjs --moduleResolution node --target ES2022 --esModuleInterop --skipLibCheck --strict --types node",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p migration-from-supabase/tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "schema:pull": "tsx src/pull-schema.ts",
    "dev": "bash seed/dev-db.sh",
    "demo": "bash seed/demo/demo-db.sh",
    "create-restaurant": "bash seed/bootstrap/create-restaurant.sh",
    "rehearse-migration": "bash migration-from-supabase/rehearse.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
